PROBE DeclaredOversize | adapter Failure(Sent, BodyTooLarge) | http_gun Failure(DeadlineExceeded, MayHaveBeenSent)
PROBE EndlessChunked | adapter Failure(Sent, BodyTooLarge) | http_gun Failure(LimitExceeded(CollectedBodyBytes, 4096, 5000), MayHaveBeenSent)
PROBE CloseDelimitedOversize | adapter Failure(Sent, BodyTooLarge) | http_gun Failure(LimitExceeded(CollectedBodyBytes, 4096, 10000), MayHaveBeenSent)
PROBE ManyHeaders | adapter Failure(Sent, HeadersTooLarge) | http_gun Failure(RequestFailed(HeaderLimitReached), MayHaveBeenSent)
PROBE BigHeaderLine | adapter Failure(Sent, HeadersTooLarge) | http_gun Failure(LimitExceeded(ResponseHeaderBytes, 16384, 40020), MayHaveBeenSent)
PROBE Gzip | adapter Failure(Sent, UnsupportedContentEncoding) | http_gun Ok(200)
PROBE Truncated | adapter Failure(Sent, ReceiveFailed) | http_gun Failure(RequestFailed(PeerClosed), MayHaveBeenSent)
PROBE BadStatus | adapter Failure(Sent, ReceiveFailed) | http_gun Failure(ConnectionFailed(UnknownTransport), MayHaveBeenSent)
PROBE BareLfHead | adapter Ok(200, headers 0, body "ok") | http_gun Ok(200)
PROBE SignedContentLength | adapter Failure(Sent, ReceiveFailed) | http_gun Failure(ConnectionFailed(UnknownTransport), MayHaveBeenSent)
PROBE ControlInHeader | adapter Failure(Sent, MalformedResponse) | http_gun Failure(RequestFailed(ProtocolError), MayHaveBeenSent)
PROBE SignedChunkSize | adapter Failure(Sent, ReceiveFailed) | http_gun Failure(RequestFailed(PeerClosed), MayHaveBeenSent)
PROBE HeaderOvershoot | adapter Failure(Sent, HeadersTooLarge) | http_gun Failure(LimitExceeded(ResponseHeaderBytes, 16384, 25021), MayHaveBeenSent)
