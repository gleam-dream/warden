#!/bin/sh
# Fast gate: formatting, warnings-as-errors build, fast test suite, negative
# compile tests and the public-API consumer. Needs no provider or network.
#   nix develop -c scripts/check
set -eu
ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"
echo "== format"; gleam format --check src test
echo "== build"; gleam build --warnings-as-errors
echo "== fast suite"; WARDEN_SUITE=fast gleam test
if [ -x scripts/negative ]; then echo "== negative compile tests"; scripts/negative; fi
if [ -d consumer ]; then echo "== consumer"; (cd consumer && gleam format --check src test && gleam build --warnings-as-errors && gleam test); fi
echo "fast gate: ok"
